<?xml version="1.0"?>
<robot name="smart_room_robot">
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.5 1.0 1.0"/>
  </material>
  <material name="red">
    <color rgba="1.0 0.1 0.1 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.2 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="1.0 0.9 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.3 0.3 0.2"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.3 0.2"/>
      </geometry>
    </collision>
  </link>

  <link name="temp_sensor_link">
    <visual>
      <geometry>
        <box size="0.04 0.02 0.04"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.02 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="temp_sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="temp_sensor_link"/>
    <origin xyz="-0.17 0.0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="humidity_sensor_link">
    <visual>
      <geometry>
        <box size="0.04 0.02 0.04"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.02 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="humidity_sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="humidity_sensor_link"/>
    <origin xyz="0.17 0.0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.1 0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.1 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.05 0.0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="speaker_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.03"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="speaker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="speaker_link"/>
    <origin xyz="0.0 0.16 0.0" rpy="1.5708 0 0"/>
  </joint>

  <link name="fan_link">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.01"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.08" length="0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="fan_joint" type="continuous">
    <parent link="base_link"/>
    <child link="fan_link"/>
    <origin xyz="0.0 0.0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

</robot>
